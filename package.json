{
  "name": "tom-cattery",
  "displayName": "Tom Cattery",
  "description": "Tomcat Server Manager for VSCode - raise your Tomcats in one place",
  "version": "0.3.0",
  "publisher": "tofu9",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/woongki/tom-cattery"
  },
  "keywords": [
    "tomcat",
    "java",
    "server",
    "debug",
    "deploy",
    "war",
    "gradle"
  ],
  "galleryBanner": {
    "color": "#2D2D2D",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "esbuild": "npm run esbuild-base",
    "esbuild-watch": "npm run esbuild-base -- --watch",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tom-cattery",
          "title": "Tom Cattery",
          "icon": "resources/tom-cattery-terminal-ears.svg"
        }
      ]
    },
    "views": {
      "tom-cattery": [
        {
          "id": "tomCattery.servers",
          "name": "Servers"
        }
      ]
    },
    "commands": [
      {
        "command": "tomCattery.addServer",
        "title": "Tom Cattery: New Server",
        "icon": "$(add)"
      },
      {
        "command": "tomCattery.addRuntime",
        "title": "Tom Cattery: Add Runtime"
      },
      {
        "command": "tomCattery.downloadRuntime",
        "title": "Tom Cattery: Download Runtime",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tomCattery.startServer",
        "title": "Tom Cattery: Start Server",
        "icon": "$(play)"
      },
      {
        "command": "tomCattery.stopServer",
        "title": "Tom Cattery: Stop Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "tomCattery.restartServer",
        "title": "Tom Cattery: Restart Server",
        "icon": "$(debug-restart)"
      },
      {
        "command": "tomCattery.debugServer",
        "title": "Tom Cattery: Debug Server",
        "icon": "$(bug)"
      },
      {
        "command": "tomCattery.addDeployment",
        "title": "Tom Cattery: Add Deployment",
        "icon": "$(add)"
      },
      {
        "command": "tomCattery.deploy",
        "title": "Tom Cattery: Deploy",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "tomCattery.redeployAll",
        "title": "Tom Cattery: Redeploy All"
      },
      {
        "command": "tomCattery.openConfig",
        "title": "Tom Cattery: Edit Configuration",
        "icon": "$(gear)"
      },
      {
        "command": "tomCattery.openLogs",
        "title": "Tom Cattery: Open Logs",
        "icon": "$(output)"
      },
      {
        "command": "tomCattery.cleanDeployment",
        "title": "Tom Cattery: Clean Deployment",
        "icon": "$(close)"
      },
      {
        "command": "tomCattery.editDeployment",
        "title": "Tom Cattery: Edit Deployment",
        "icon": "$(edit)"
      },
      {
        "command": "tomCattery.removeDeployment",
        "title": "Tom Cattery: Remove Deployment",
        "icon": "$(trash)"
      },
      {
        "command": "tomCattery.toggleAutoDeploy",
        "title": "Tom Cattery: Toggle Auto Deploy",
        "icon": "$(eye)"
      },
      {
        "command": "tomCattery.deleteServer",
        "title": "Tom Cattery: Delete Server",
        "icon": "$(trash)"
      },
      {
        "command": "tomCattery.resetGlobalStorage",
        "title": "Tom Cattery: Reset All Data",
        "icon": "$(warning)"
      },
      {
        "command": "tomCattery.exportConfig",
        "title": "Tom Cattery: Export Server Config",
        "icon": "$(arrow-up)"
      },
      {
        "command": "tomCattery.importConfig",
        "title": "Tom Cattery: Import Server Config",
        "icon": "$(download)"
      },
      {
        "command": "tomCattery.cloneServer",
        "title": "Tom Cattery: Clone Server",
        "icon": "$(copy)"
      },
      {
        "command": "tomCattery.saveToWorkspace",
        "title": "Tom Cattery: Save to Workspace",
        "icon": "$(root-folder)"
      },
      {
        "command": "tomCattery.addGradleDeployments",
        "title": "Tom Cattery: Add Gradle Deployments",
        "icon": "$(package)"
      }
    ],
    "viewsWelcome": [
      {
        "view": "tomCattery.servers",
        "contents": "No servers yet.\n[Add Server](command:tomCattery.addServer)"
      }
    ],
    "configuration": {
      "title": "Tom Cattery",
      "properties": {
        "tomCattery.defaultHttpPort": {
          "type": "number",
          "default": 8080,
          "description": "새 서버의 기본 HTTP 포트"
        },
        "tomCattery.autoResolvePortConflicts": {
          "type": "boolean",
          "default": true,
          "description": "포트 충돌 시 자동으로 사용 가능한 포트 할당"
        },
        "tomCattery.openBrowserOnStart": {
          "type": "boolean",
          "default": true,
          "description": "서버 시작/디버그 시 기본 브라우저에서 자동으로 열기"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "tomCattery.addServer",
          "when": "view == tomCattery.servers",
          "group": "navigation"
        },
        {
          "command": "tomCattery.importConfig",
          "when": "view == tomCattery.servers",
          "group": "navigation"
        },
        {
          "command": "tomCattery.exportConfig",
          "when": "view == tomCattery.servers",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tomCattery.startServer",
          "when": "view == tomCattery.servers && viewItem == server-stopped",
          "group": "inline@1"
        },
        {
          "command": "tomCattery.debugServer",
          "when": "view == tomCattery.servers && viewItem == server-stopped",
          "group": "inline@2"
        },
        {
          "command": "tomCattery.stopServer",
          "when": "view == tomCattery.servers && viewItem =~ /server-(starting|running|debugging)/",
          "group": "inline@1"
        },
        {
          "command": "tomCattery.restartServer",
          "when": "view == tomCattery.servers && viewItem =~ /server-(starting|running|debugging)/",
          "group": "inline@2"
        },
        {
          "command": "tomCattery.openConfig",
          "when": "view == tomCattery.servers && viewItem =~ /server-.*/",
          "group": "0_global_config@1"
        },
        {
          "command": "tomCattery.addDeployment",
          "when": "view == tomCattery.servers && viewItem =~ /server-.*/",
          "group": "1_actions@1"
        },
        {
          "command": "tomCattery.addGradleDeployments",
          "when": "view == tomCattery.servers && viewItem =~ /server-.*/",
          "group": "1_actions@2"
        },
        {
          "command": "tomCattery.redeployAll",
          "when": "view == tomCattery.servers && viewItem =~ /server-.*/",
          "group": "1_actions@3"
        },
        {
          "command": "tomCattery.cleanDeployment",
          "when": "view == tomCattery.servers && viewItem =~ /server-.*/",
          "group": "1_actions@4"
        },
        {
          "command": "tomCattery.openLogs",
          "when": "view == tomCattery.servers && viewItem =~ /server-.*/",
          "group": "2_config@2"
        },
        {
          "command": "tomCattery.cloneServer",
          "when": "view == tomCattery.servers && viewItem =~ /server-.*/",
          "group": "2_config@3"
        },
        {
          "command": "tomCattery.saveToWorkspace",
          "when": "view == tomCattery.servers && viewItem =~ /server-.*/",
          "group": "2_config@4"
        },
        {
          "command": "tomCattery.exportConfig",
          "when": "view == tomCattery.servers && viewItem =~ /server-.*/",
          "group": "2_config@5"
        },
        {
          "command": "tomCattery.deleteServer",
          "when": "view == tomCattery.servers && viewItem =~ /server-.*/",
          "group": "3_danger@1"
        },
        {
          "command": "tomCattery.deploy",
          "when": "view == tomCattery.servers && viewItem =~ /deployment.*/",
          "group": "inline@1"
        },
        {
          "command": "tomCattery.toggleAutoDeploy",
          "when": "view == tomCattery.servers && viewItem =~ /deployment.*/",
          "group": "inline@2"
        },
        {
          "command": "tomCattery.editDeployment",
          "when": "view == tomCattery.servers && viewItem =~ /deployment.*/",
          "group": "1_actions@1"
        },
        {
          "command": "tomCattery.toggleAutoDeploy",
          "when": "view == tomCattery.servers && viewItem =~ /deployment.*/",
          "group": "1_actions@2"
        },
        {
          "command": "tomCattery.removeDeployment",
          "when": "view == tomCattery.servers && viewItem =~ /deployment.*/",
          "group": "2_danger@1"
        }
      ]
    }
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "adm-zip": "^0.5.10",
    "fast-xml-parser": "^4.3.0",
    "portfinder": "^1.0.32"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  }
}
